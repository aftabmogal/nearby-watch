# --- Database (MongoDB Atlas free-tier cluster recommended) ---
MONGO_URI=mongodb+srv://aftabmogal:aftab8355@cluster0.jvksbij.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=nearby_watch

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email / OTP ---
# "console" logs the OTP code to the terminal — no API key needed, use this for local dev.
# Switch to "resend" or "sendgrid" (and add the matching key) when you're ready to send real emails.
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@localfinder.dev
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- File storage ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads/posts
MAX_PHOTOS_PER_POST=3
MAX_PHOTO_SIZE_MB=5

# --- Real-time notifications ---
NOTIFY_RADIUS_KM=5.0

# --- CORS ---
FRONTEND_URL=http://localhost:5173
